generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id               String   @id @default(cuid()) // Unique internal DB ID
  matricula        String   @unique // The 9-digit random ID
  nombres          String
  apellidoPaterno  String
  apellidoMaterno  String
  seudonimo        String?
  correo           String   @unique
  telefono         String
  ciudad           String
  estado           String
  
  rol              String
  experiencia      Int
  otrosEventos     String
  cualesEventos    String?
  organizacion     String
  cualOrganizacion String?
  
  actividades      String[] // Array of selected activities
  matchmaking      String
  expectativas     String
  area1            String?
  area2            String?
  area3            String?
  importancia      Int
  
  createdAt        DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
}
